private theorem table_checks : ∀ i : Fin 48,
    bell (i.val+1) = ∑ r ∈ Icc 1 (i.val+1), Nat.fast_choose (i.val+1) r * bell (i.val+1-r) := by
  decide +kernel

theorem bell_step {i : ℕ} (hi : i < 48) : bell (i+1) =
    ∑ r ∈ Icc 1 (i+1), (i+1).choose r * bell (i+1-r) := by
  rw [Nat.choose_eq_fast_choose]
  exact table_checks ⟨i,hi⟩

theorem bell_real (n : ℕ) (hn : n ≤ 48) : (row n 1).eval 1 = (bell n : ℝ) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    cases n with
    | zero => simp only [row_zero (by decide : 1 ≤ 1), eval_one, show bell 0 = 1 by rfl, Nat.cast_one]
    | succ m =>
      rw [row_recurrence m (by decide : 1 ≤ 1), eval_finsetSum, bell_step (by omega), Nat.cast_sum]
      apply sum_congr rfl
      intro r hr
      have h₁ := (mem_Icc.mp hr).1
      simp only [nsmul_eq_mul, eval_mul, eval_natCast, eval_pow, eval_X, one_pow, mul_one, Nat.cast_mul]
      rw [ih _ (by omega) (by omega)]

#print axioms bell_real
